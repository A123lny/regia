# Valori stampati da 'npx supabase start' — copiare qui.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54520
NEXT_PUBLIC_SUPABASE_ANON_KEY=<da supabase start>
SUPABASE_SERVICE_ROLE_KEY=<da supabase start — MAI esporre lato client>

# --- F1.5a Motore editoriale ---
# Anthropic API — Claude sonnet 4.6 per generazione contenuti (RS-2, §9.2).
# Chiave da https://console.anthropic.com
ANTHROPIC_API_KEY=

# Voyage AI — embeddings 512d per retrieval semantico rifiuti (RF-3.8).
